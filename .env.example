# The server's settings (see README.md). The server doesn't read this file: set the variables in
# the environment (Render's Environment tab). Every one is optional.

# The frontend's origins, comma-separated: the only websites whose pages can connect
FRONTEND_URL=http://localhost:8080

# The header a trusted proxy writes the caller's address in (cf-connecting-ip on Render by default)
# CLIENT_IP_HEADER=cf-connecting-ip

# Refuse frontends that don't keep a device token (once every device runs one that does)
# REQUIRE_DEVICE_TOKEN=false

# Creating a room and running its game need the session of a Supabase user with the admin role
# (app_metadata.role); the guests need none. Needs the two Supabase variables below
# REQUIRE_ADMIN_AUTH=false
# ADMIN_ROLE=admin
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key

# Limits
# MAX_CONNECTIONS=5000
# MAX_CONNECTIONS_PER_IP=100
# CONNECTIONS_PER_IP_PER_MINUTE=120
# MAX_ROOMS=1000
# MAX_DEVICES_PER_ROOM=100
# MAX_MESSAGE_BYTES=524288

# Timeouts
# ADMIN_AWAY_TIMEOUT_MS=60000
# INACTIVE_DEVICE_TIMEOUT_MS=600000

# debug, info, warn, error or silent
# LOG_LEVEL=info
